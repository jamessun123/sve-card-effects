            "type": "namedFollowerOnFieldByName",
            "identityName": "Anne, Belle of Mysteria"
          },
          "effect": {
            "op": "playCostReduction",
            "amount": 2
          }
        },
        {
          "timing": "activated",
          "cost": {
            "engage": true
          },
          "effect": {
            "op": "if",
            "condition": {
              "type": "namedFollowerOnFieldByName",
              "identityName": "Anne, Belle of Mysteria"
            },
            "then": {
              "op": "dealDamage",
              "amount": 6,
              "targets": {
                "type": "enemyFollower",
                "count": 1
              }
            },
            "else": {
              "op": "dealDamage",
              "amount": 3,
              "targets": {
                "type": "enemyFollower",
                "count": 1
              }
            }
          }
        }
      ],
      "parseConfidence": "high"
